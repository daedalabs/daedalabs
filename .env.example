# GitHub Organization Sync
GITHUB_ORG=daedalabs
# GitHub Personal Access Token (REQUIRED in production)
# Unauthenticated GitHub API allows only 60 requests/hour; authenticated requests allow 5,000 req/hour.
# A token is necessary in production to prevent rate limit exhaustion during ISR revalidations and builds.
GITHUB_TOKEN=ghp_your_personal_access_token
# Secret for securing GitHub webhook endpoint (/api/webhook/github). Required in production.
GITHUB_WEBHOOK_SECRET=your-random-webhook-secret

# Public Site URL
# NEXT_PUBLIC_SITE_URL=https://daedalabs.tech

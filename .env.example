# Optional secret for securing GitHub webhook endpoint (/api/webhook/github)
# GITHUB_WEBHOOK_SECRET=your-random-webhook-secret

# Public Site URL
# NEXT_PUBLIC_SITE_URL=https://daedalabs.tech
